# EditorConfig for Unity projects
# Suppress warnings from Unity-generated and library code

root = true

# All files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
indent_style = space
indent_size = 4

# Suppress warnings in Unity's generated and library folders
[{Library/**,Temp/**,Packages/**,obj/**,Logs/**}]
generated_code = true

# Suppress common Unity warnings globally (including Library code)
[*.cs]
# CS0649: Field is never assigned to, and will always have its default value
# This is normal for Unity's [SerializeField] pattern
dotnet_diagnostic.CS0649.severity = none

# CS0414: Field is assigned but never used
# Common in Unity for inspector-only fields
dotnet_diagnostic.CS0414.severity = none
dotnet_diagnostic.CS0618.severity = none
dotnet_diagnostic.CS9236.severity = none

# IDE0051: Private member is unused
# Unity uses reflection for many methods (Start, Update, etc.)
dotnet_diagnostic.IDE0051.severity = none

# Your project code - keep normal analysis
[Assets/Scripts/**/*.cs]
dotnet_diagnostic.CS0649.severity = warning
dotnet_diagnostic.CS0414.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
